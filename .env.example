# ── 9Router (OpenAI-compatible) ──────────────────────────
NINEROUTER_API_KEY=sk-your-key
# 9Router runs LOCALLY on this machine. Copy the exact endpoint from the
# 9Router dashboard (usually http://localhost:<port>/v1).
NINEROUTER_BASE_URL=http://localhost:20128/v1
# Tip: for much faster replies use a smaller/faster model, e.g. gpt-4o-mini
MODEL=gpt-4o
VISION_MODEL=gpt-4o
LLM_TIMEOUT=90

# ── Telegram ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
ALLOWED_TELEGRAM_IDS=111111111,222222222

# ── Web interface ────────────────────────────────────────
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_AUTH_TOKEN=change-me-please

# ── Browser ──────────────────────────────────────────────
HEADLESS=true
# Optional: attach to YOUR already-open Chrome.
# Launch Chrome with:  chrome --remote-debugging-port=9222
# then set:
CHROME_CDP_URL=

# ── Security ─────────────────────────────────────────────
ENABLE_SYSTEM_TOOLS=true
ENABLE_SHELL=false
ENABLE_FILE_WRITE=false
REQUIRE_CONFIRMATION=true
MAX_STEPS=30

# ── Memory / Scheduler ───────────────────────────────────
DB_PATH=homa.db

# ── Mail (optional, IMAP/SMTP) ───────────────────────────
IMAP_HOST=imap.gmail.com
IMAP_USER=you@gmail.com
IMAP_PASSWORD=app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
